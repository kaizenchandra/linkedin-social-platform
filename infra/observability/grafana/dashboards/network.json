{
  "title": "Professional Network MVP",
  "uid": "network-mvp",
  "schemaVersion": 41,
  "version": 4,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (application) (rate(http_server_requests_seconds_count[1m]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 2,
      "title": "HTTP p95 seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le,application) (rate(http_server_requests_seconds_bucket[1m])))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 3,
      "title": "HTTP errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 4,
      "title": "Active database connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 5,
      "title": "Outbox backlog",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "outbox_backlog",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 6,
      "title": "Outbox failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(outbox_failures_total[1m])",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 7,
      "title": "Notifications processed",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(notifications_processed_total[1m])",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 8,
      "title": "Consumer failures / DLT",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(notifications_failures_total[1m]) or rate(notifications_deadletters_total[1m])",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 9,
      "title": "Media storage failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (application) (rate(media_storage_failures_total[5m]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      }
    },
    {
      "id": 10,
      "title": "Media reconciliation failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (application) (rate(media_reconciliation_failures_total[5m]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 8
      }
    },
    {
      "id": 11,
      "title": "Media objects cleaned",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (application) (rate(media_cleanup_deleted_total[5m]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 8
      }
    },
    {
      "id": 12,
      "title": "Hiring API p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le,uri) (rate(http_server_requests_seconds_bucket{application=\"hiring-service\"}[5m])))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 13,
      "title": "Discovery scanned versus returned",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by(query) (rate(network_discovery_candidates_total[5m])) / clamp_min(sum by(query) (rate(network_discovery_returned_total[5m])),0.001)",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 14,
      "title": "Discovery query mean seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by(query)(rate(network_discovery_query_seconds_sum[5m])) / clamp_min(sum by(query)(rate(network_discovery_query_seconds_count[5m])),0.001)",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 64,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 15,
      "title": "Matching backlog",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "network_alert_backlog",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 72,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 16,
      "title": "Oldest matching work seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "network_alert_oldest_seconds",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 72,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 17,
      "title": "Failed matching work",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "network_alert_failed",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 80,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 18,
      "title": "Alert retry and deduplication outcomes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by(outcome)(rate(network_alert_matches_total[5m]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 80,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 19,
      "title": "Notification match-to-delivery seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(notifications_job_alert_latency_seconds_sum[5m])/clamp_min(rate(notifications_job_alert_latency_seconds_count[5m]),0.001)",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 88,
        "w": 12,
        "h": 8
      }
    }
  ]
}
