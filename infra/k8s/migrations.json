    {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {
        "name": "kafka-acls-v1",
        "namespace": "network-mvp"
      },
      "spec": {
        "backoffLimit": 3,
        "template": {
          "spec": {
            "restartPolicy": "Never",
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "kafka-init",
                "image": "apache/kafka:4.1.2@sha256:5cc2a2fd93fa2687b44015eee04fb2c3edd9e526bd64bf8bec5ff1e268772e0e",
                "command": [
                  "/bin/bash",
                  "/opt/network/init.sh"
                ],
                "env": [
                  {
                    "name": "KAFKA_ADMIN_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "network-secrets",
                        "key": "KAFKA_ADMIN_PASSWORD"
                      }
                    }
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "scripts",
                    "mountPath": "/opt/network"
                  }
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "512Mi"
                  }
                }
              }
            ],
            "volumes": [
              {
                "name": "scripts",
                "configMap": {
                  "name": "kafka-scripts"
                }
              }
            ],
            "securityContext": {
              "runAsUser": 1000,
              "runAsNonRoot": true,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            }
          }
        }
      }
    }
