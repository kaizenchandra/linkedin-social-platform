{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {
        "name": "member-migration-v1",
        "namespace": "network-mvp",
        "labels": {
          "app": "member-migration-v1"
        }
      },
      "spec": {
        "backoffLimit": 2,
        "activeDeadlineSeconds": 300,
        "template": {
          "spec": {
            "restartPolicy": "Never",
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsUser": 10001,
              "runAsNonRoot": true,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "migration",
                "image": "professional-network/member-service:0.1.0",
                "imagePullPolicy": "IfNotPresent",
                "command": [
                  "java",
                  "-Dloader.main=dev.network.web.Migrate",
                  "-cp",
                  "/app/app.jar",
                  "org.springframework.boot.loader.launch.PropertiesLauncher"
                ],
                "env": [
                  {
                    "name": "DB_URL",
                    "value": "jdbc:oracle:thin:@//oracle:1521/FREEPDB1"
                  },
                  {
                    "name": "DB_USER",
                    "value": "member_app"
                  },
                  {
                    "name": "DB_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "network-secrets",
                        "key": "MEMBER_DB_PASSWORD"
                      }
                    }
                  },
                  {
                    "name": "DB_RUNTIME_USER",
                    "value": "member_runtime"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "512Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
