{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "member-service",
        "namespace": "network-mvp",
        "labels": {
          "app": "member-service"
        }
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "RollingUpdate",
          "rollingUpdate": {
            "maxSurge": 1,
            "maxUnavailable": 0
          }
        },
        "selector": {
          "matchLabels": {
            "app": "member-service"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "member-service"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsUser": 10001,
              "runAsNonRoot": true,
              "fsGroup": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "terminationGracePeriodSeconds": 35,
            "containers": [
              {
                "name": "member-service",
                "image": "professional-network/member-service:0.4.0",
                "imagePullPolicy": "IfNotPresent",
                "env": [
                  {
                    "name": "OIDC_ISSUER",
                    "value": "http://localhost:8180/realms/network"
                  },
                  {
                    "name": "OIDC_JWKS",
                    "value": "http://keycloak:8080/realms/network/protocol/openid-connect/certs"
                  },
                  {
                    "name": "JAVA_TOOL_OPTIONS",
                    "value": "-XX:MaxRAMPercentage=65"
                  },
                  {
                    "name": "MEMBER_URL",
                    "value": "http://member-service:8080"
                  },
                  {
                    "name": "CONTENT_URL",
                    "value": "http://content-service:8080"
                  },
                  {
                    "name": "NOTIFICATION_URL",
                    "value": "http://notification-service:8080"
                  },
                  {
                    "name": "DB_URL",
                    "value": "jdbc:oracle:thin:@//oracle:1521/FREEPDB1"
                  },
                  {
                    "name": "DB_USER",
                    "value": "member_runtime"
                  },
                  {
                    "name": "DB_SCHEMA",
                    "value": "member_app"
                  },
                  {
                    "name": "DB_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "network-secrets",
                        "key": "MEMBER_RUNTIME_PASSWORD"
                      }
                    }
                  },
                  {
                    "name": "MIGRATIONS_ENABLED",
                    "value": "false"
                  },
                  {
                    "name": "KAFKA_BOOTSTRAP",
                    "value": "kafka:19092"
                  },
                  {
                    "name": "KAFKA_SECURITY_PROTOCOL",
                    "value": "SASL_PLAINTEXT"
                  },
                  {
                    "name": "KAFKA_USER",
                    "value": "member"
                  },
                  {
                    "name": "KAFKA_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "network-secrets",
                        "key": "KAFKA_MEMBER_PASSWORD"
                      }
                    }
                  }
                ],
                "ports": [
                  {
                    "containerPort": 8080
                  },
                  {
                    "containerPort": 9090
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "2",
                    "memory": "640Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/actuator/health/readiness",
                    "port": 9090
                  },
                  "periodSeconds": 5,
                  "failureThreshold": 60,
                  "timeoutSeconds": 3
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/actuator/health/readiness",
                    "port": 9090
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 3
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/actuator/health/liveness",
                    "port": 9090
                  },
                  "periodSeconds": 10,
                  "failureThreshold": 6,
                  "timeoutSeconds": 3
                }
              }
            ]
          }
        }
      }
    },
