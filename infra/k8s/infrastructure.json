                      "localhost:19092",
                      "--list",
                      "--command-config",
                      "/tmp/admin.properties"
                    ]
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 3
                },
                "livenessProbe": {
                  "exec": {
                    "command": [
                      "/opt/kafka/bin/kafka-topics.sh",
                      "--bootstrap-server",
                      "localhost:19092",
                      "--list",
                      "--command-config",
                      "/tmp/admin.properties"
                    ]
                  },
                  "periodSeconds": 10,
                  "failureThreshold": 6,
                  "timeoutSeconds": 3
                },
                "command": [
                  "/bin/bash",
                  "/opt/network/start.sh"
                ]
              }
            ],
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "kafka-data"
                }
              },
              {
                "name": "scripts",
                "configMap": {
                  "name": "kafka-scripts"
                }
              }
            ]
          }
        }
      }
    },
