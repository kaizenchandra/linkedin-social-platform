    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "oracle-init",
        "namespace": "network-mvp",
        "labels": {
          "app": "oracle-init"
        }
      },
      "data": {
        "001-users.sh": "#!/bin/bash\nset -euo pipefail\nfor service in member content notification; do\n  upper=${service^^}\n  owner_key=${upper}_DB_PASSWORD\n  runtime_key=${upper}_RUNTIME_PASSWORD\n  sqlplus -s / as sysdba <<SQL\nWHENEVER SQLERROR EXIT SQL.SQLCODE\nALTER SESSION SET CONTAINER=FREEPDB1;\nCREATE USER ${service}_app IDENTIFIED BY \"${!owner_key}\" QUOTA 100M ON USERS;\nGRANT CREATE SESSION, CREATE TABLE, CREATE SEQUENCE TO ${service}_app;\nCREATE USER ${service}_runtime IDENTIFIED BY \"${!runtime_key}\";\nGRANT CREATE SESSION TO ${service}_runtime;\nSQL\ndone\n",
        "002-mvp2-users.sh": "#!/bin/bash\nset -euo pipefail\nfor service in media messaging; do\n  upper=${service^^}\n  owner_key=${upper}_DB_PASSWORD\n  runtime_key=${upper}_RUNTIME_PASSWORD\n  sqlplus -s / as sysdba <<SQL\nWHENEVER SQLERROR EXIT SQL.SQLCODE\nALTER SESSION SET CONTAINER=FREEPDB1;\nDECLARE n NUMBER;\nBEGIN\n SELECT COUNT(*) INTO n FROM dba_users WHERE username=UPPER('${service}_app');\n IF n=0 THEN\n  EXECUTE IMMEDIATE 'CREATE USER ${service}_app IDENTIFIED BY \"${!owner_key}\" QUOTA 500M ON USERS';\n  EXECUTE IMMEDIATE 'GRANT CREATE SESSION, CREATE TABLE, CREATE SEQUENCE TO ${service}_app';\n END IF;\n SELECT COUNT(*) INTO n FROM dba_users WHERE username=UPPER('${service}_runtime');\n IF n=0 THEN\n  EXECUTE IMMEDIATE 'CREATE USER ${service}_runtime IDENTIFIED BY \"${!runtime_key}\"';\n  EXECUTE IMMEDIATE 'GRANT CREATE SESSION TO ${service}_runtime';\n END IF;\nEND;\n/\nSQL\ndone\n",
        "003-hiring-users.sh": "#!/bin/bash\nset -euo pipefail\nfor service in hiring; do\n  upper=${service^^}\n  owner_key=${upper}_DB_PASSWORD\n  runtime_key=${upper}_RUNTIME_PASSWORD\n  sqlplus -s / as sysdba <<SQL\nWHENEVER SQLERROR EXIT SQL.SQLCODE\nALTER SESSION SET CONTAINER=FREEPDB1;\nDECLARE n NUMBER;\nBEGIN\n SELECT COUNT(*) INTO n FROM dba_users WHERE username=UPPER('${service}_app');\n IF n=0 THEN\n  EXECUTE IMMEDIATE 'CREATE USER ${service}_app IDENTIFIED BY \"${!owner_key}\" QUOTA 500M ON USERS';\n  EXECUTE IMMEDIATE 'GRANT CREATE SESSION, CREATE TABLE, CREATE SEQUENCE TO ${service}_app';\n END IF;\n SELECT COUNT(*) INTO n FROM dba_users WHERE username=UPPER('${service}_runtime');\n IF n=0 THEN\n  EXECUTE IMMEDIATE 'CREATE USER ${service}_runtime IDENTIFIED BY \"${!runtime_key}\"';\n  EXECUTE IMMEDIATE 'GRANT CREATE SESSION TO ${service}_runtime';\n END IF;\nEND;\n/\nSQL\ndone\n"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "keycloak-realm",
        "namespace": "network-mvp",
        "labels": {
          "app": "keycloak-realm"
        }
      },
      "data": {
        "network-realm.json": "{\n  \"realm\": \"network\",\n  \"enabled\": true,\n  \"registrationAllowed\": true,\n  \"resetPasswordAllowed\": true,\n  \"accessTokenLifespan\": 300,\n  \"sslRequired\": \"none\",\n  \"roles\": {\n    \"realm\": [\n      {\n        \"name\": \"moderator\",\n        \"description\": \"Explicit audited content moderation only\"\n      }\n    ]\n  },\n  \"clientScopes\": [\n    {\n      \"name\": \"network-audience\",\n      \"protocol\": \"openid-connect\",\n      \"protocolMappers\": [\n        {\n          \"name\": \"audience\",\n          \"protocol\": \"openid-connect\",\n          \"protocolMapper\": \"oidc-audience-mapper\",\n          \"config\": {\n            \"included.custom.audience\": \"network-api\",\n            \"access.token.claim\": \"true\"\n          }\n        },\n        {\n          \"name\": \"subject\",\n          \"protocol\": \"openid-connect\",\n          \"protocolMapper\": \"oidc-sub-mapper\",\n          \"config\": {\n            \"access.token.claim\": \"true\",\n            \"id.token.claim\": \"true\",\n            \"introspection.token.claim\": \"true\"\n          }\n        },\n        {\n          \"name\": \"trusted-realm-roles\",\n          \"protocol\": \"openid-connect\",\n          \"protocolMapper\": \"oidc-usermodel-realm-role-mapper\",\n          \"config\": {\n            \"claim.name\": \"realm_access.roles\",\n            \"jsonType.label\": \"String\",\n            \"multivalued\": \"true\",\n            \"access.token.claim\": \"true\"\n          }\n        }\n      ]\n    },\n    {\n      \"name\": \"connections.read\",\n      \"protocol\": \"openid-connect\",\n      \"attributes\": {\n        \"include.in.token.scope\": \"true\"\n      }\n    },\n    {\n      \"name\": \"metrics.read\",\n      \"protocol\": \"openid-connect\",\n      \"attributes\": {\n        \"include.in.token.scope\": \"true\"\n      }\n    },\n    {\n      \"name\": \"media.manage\",\n      \"protocol\": \"openid-connect\",\n      \"attributes\": {\n        \"include.in.token.scope\": \"true\"\n      }\n    },\n    {\n      \"name\": \"hiring.profiles\",\n      \"protocol\": \"openid-connect\",\n      \"attributes\": {\n        \"include.in.token.scope\": \"true\"\n      }\n    },\n    {\n      \"name\": \"hiring.recipients\",\n      \"protocol\": \"openid-connect\",\n      \"attributes\": {\n        \"include.in.token.scope\": \"true\"\n      }\n    }\n  ],\n  \"clients\": [\n    {\n      \"clientId\": \"network-web\",\n      \"publicClient\": true,\n      \"standardFlowEnabled\": true,\n      \"directAccessGrantsEnabled\": false,\n      \"redirectUris\": [\n        \"http://localhost:3000/callback\",\n        \"http://localhost:8765/callback\"\n      ],\n      \"webOrigins\": [\n        \"http://localhost:3000\"\n      ],\n      \"attributes\": {\n        \"pkce.code.challenge.method\": \"S256\"\n      },\n      \"defaultClientScopes\": [\n        \"network-audience\"\n      ]\n    },\n    {\n      \"clientId\": \"content-internal\",\n      \"publicClient\": false,\n      \"secret\": \"${CONTENT_CLIENT_SECRET}\",\n      \"serviceAccountsEnabled\": true,\n      \"standardFlowEnabled\": false,\n      \"directAccessGrantsEnabled\": false,\n      \"defaultClientScopes\": [\n        \"network-audience\",\n        \"connections.read\"\n      ]\n    },\n    {\n      \"clientId\": \"metrics\",\n      \"publicClient\": false,\n      \"secret\": \"${METRICS_CLIENT_SECRET}\",\n      \"serviceAccountsEnabled\": true,\n      \"standardFlowEnabled\": false,\n      \"directAccessGrantsEnabled\": false,\n      \"defaultClientScopes\": [\n        \"network-audience\",\n        \"metrics.read\"\n      ]\n    },\n    {\n      \"clientId\": \"media-internal\",\n      \"publicClient\": false,\n      \"secret\": \"${MEDIA_CLIENT_SECRET}\",\n      \"serviceAccountsEnabled\": true,\n      \"standardFlowEnabled\": false,\n      \"directAccessGrantsEnabled\": false,\n      \"defaultClientScopes\": [\n        \"network-audience\",\n        \"connections.read\",\n        \"media.manage\"\n      ]\n    },\n    {\n      \"clientId\": \"messaging-internal\",\n      \"publicClient\": false,\n      \"secret\": \"${MESSAGING_CLIENT_SECRET}\",\n      \"serviceAccountsEnabled\": true,\n      \"standardFlowEnabled\": false,\n      \"directAccessGrantsEnabled\": false,\n      \"defaultClientScopes\": [\n        \"network-audience\",\n        \"connections.read\"\n      ]\n    },\n    {\n      \"clientId\": \"hiring-internal\",\n      \"publicClient\": false,\n      \"secret\": \"${HIRING_CLIENT_SECRET}\",\n      \"serviceAccountsEnabled\": true,\n      \"standardFlowEnabled\": false,\n      \"directAccessGrantsEnabled\": false,\n      \"defaultClientScopes\": [\n        \"network-audience\",\n        \"hiring.profiles\"\n      ]\n    },\n    {\n      \"clientId\": \"notification-internal\",\n      \"publicClient\": false,\n      \"secret\": \"${NOTIFICATION_CLIENT_SECRET}\",\n      \"serviceAccountsEnabled\": true,\n      \"standardFlowEnabled\": false,\n      \"directAccessGrantsEnabled\": false,\n      \"defaultClientScopes\": [\n        \"network-audience\",\n        \"hiring.recipients\"\n      ]\n    }\n  ]\n}\n"
      }
