{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "resourceId",
    "resourceVersion",
    "cursor"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "enum": [
        "conversation.created",
        "message.created",
        "conversation.read",
        "conversation.preferences",
        "notification.created",
        "notification.read"
      ]
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "resourceId": {
      "type": "string",
      "format": "uuid"
    },
    "resourceVersion": {
      "type": "integer",
      "minimum": 0
    },
    "cursor": {
      "type": "string",
      "maxLength": 240
    }
  }
}
